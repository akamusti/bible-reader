{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Söz",
  "version": "0.1.0",
  "identifier": "app.soz.bible",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Söz — Kutsal Kitap",
        "width": 1120,
        "height": 780,
        "minWidth": 700,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Education",
    "shortDescription": "Türkçe ve İngilizce Kutsal Kitap okuyucu",
    "longDescription": "Söz, çevrimdışı çalışan iki dilli bir Kutsal Kitap okuyucusudur. Türkçe (YTC) ve İngilizce (KJV, WEB) çevirileri içerir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
